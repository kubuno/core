<Project Sdk="Kubuno.Rust.Sdk/1.1.1">
  <!-- The Kubuno web tooling (docs/WEB.md): F5 starts a dev core, behind the development database guard. -->
  <Sdk Name="Kubuno.Web.Sdk" Version="1.0.2" />

  <!-- Generated by "Kubuno: Generate Web Solution" (docs/WEB.md). This file is yours: it is never overwritten
       by a later run - edit it freely, or delete it and run the command again for a fresh default. -->
  <PropertyGroup>
    <CargoPackage>kubuno-core</CargoPackage>
    <CargoBin>kubuno-core</CargoBin>
    <!-- One `cargo build` of the workspace for every project of it (docs/RSPROJ.md, "Cargo workspaces"). -->
    <CargoBuildScope>Workspace</CargoBuildScope>
    <KubunoWebRole>Core</KubunoWebRole>
  </PropertyGroup>

</Project>
