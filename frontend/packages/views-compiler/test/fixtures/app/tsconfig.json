{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "rootDirs": [".", ".kubuno/views"],
    "paths": {
      "@kubuno/views": ["../../../../../src/views/index.ts"],
      "@ui": ["./src/fake-ui.ts"]
    },
    "types": []
  },
  "include": ["src", ".kubuno/views"]
}
