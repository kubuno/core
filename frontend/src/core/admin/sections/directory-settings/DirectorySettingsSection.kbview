<!-- DirectorySettingsSection — converted from DirectorySettingsSection.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel Class="contents">
  <Panel Visible="{Binding show_case_1}" Class="min-w-0">
    <!-- TODO(views-migrate): elements held in an expression -->
    <ReactHost Component="{Binding Fragment}" Props="{Binding content_title}"/>
    <EmptyState IconSize="26" Icon="Contact" Title="{Res admin.dirset_forbidden}" Description="{Res admin.dirset_forbidden_desc}"/>
  </Panel>
  <Panel Visible="{Binding show_main}" Class="min-w-0">
    <!-- TODO(views-migrate): elements held in an expression -->
    <ReactHost Component="{Binding Fragment}" Props="{Binding content_title2}"/>
    <Panel Class="mb-5 max-w-3xl">
      <Callout Title="{Res admin.dirset_intro_title}" Body="{Res admin.dirset_intro}"/>
    </Panel>
    <Panel Class="max-w-3xl">
      <!-- TODO(views-migrate): <SettingScopeBar> is no .kbview element (../../settings/SettingScopeBar#default) -->
      <ReactHost Component="{Binding SettingScopeBar}" Props="{Binding setting_scope_bar_props}"/>
      <Panel Visible="{Binding show_can_manage}" Class="mb-4">
        <Callout Body="{Res admin.settings_read_only}"/>
      </Panel>
      <Panel Visible="{Binding show_policy_error}" Class="mb-4">
        <Callout Variant="Danger" Dismissible="true" Body="{Binding policy.error}" OnDismiss="callout_dismiss"/>
      </Panel>
      <EmptyState ActionLabel="{Res admin.dirset_retry}"
                  IconSize="26"
                  Icon="Contact"
                  Title="{Res admin.dirset_load_failed}"
                  Description="{Res admin.dirset_load_failed_desc}"
                  Variant="Error"
                  Visible="{Binding policy.isError}"
                  OnAction="empty_state_action"/>
      <EmptyState IconSize="26"
                  Icon="Contact"
                  Title="{Res admin.dirset_undeclared}"
                  Description="{Res admin.dirset_undeclared_desc}"
                  Visible="{Binding visible}"/>
      <Panel Visible="{Binding visible2}" Class="space-y-5">
        <Card Title="{Res admin.dirset_card_sharing}" Subtitle="{Res admin.dirset_card_sharing_desc}" IconSize="18" Icon="Share2">
          <Panel Class="divide-y divide-border">
            <Repeater ItemKey="rowKey" ItemsSource="{Binding rows_sharing_keys}">
              <!-- TODO(views-migrate): <ToggleRow> is no .kbview element (./ToggleRow#default) -->
              <ReactHost Component="{Binding ToggleRow}" Props="{Binding toggle_row_props}"/>
            </Repeater>
          </Panel>
        </Card>
        <Card Title="{Res admin.dirset_card_profile}" Subtitle="{Res admin.dirset_card_profile_desc}" IconSize="18" Icon="UserCog">
          <Panel Class="contents">
            <Panel Class="divide-y divide-border">
              <Repeater ItemKey="rowKey" ItemsSource="{Binding rows_profile_keys}">
                <!-- TODO(views-migrate): <CheckboxRow> is no .kbview element (./CheckboxRow#default) -->
                <ReactHost Component="{Binding CheckboxRow}" Props="{Binding checkbox_row_props}"/>
              </Repeater>
              <Repeater ItemKey="key" ItemsSource="{Binding rows_profile_fields_not_stored}">
                <!-- TODO(views-migrate): <UnstoredFieldRow> is no .kbview element (./UnstoredFieldRow#default) -->
                <ReactHost Component="{Binding UnstoredFieldRow}" Props="{Binding unstored_field_row_props}"/>
              </Repeater>
            </Panel>
            <Label Text="{Res admin.dirset_profile_fields_note}"
                   Overflow="Wrap"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="mt-3 border-t border-border pt-3 [font-size:var(--kb-text-meta)]"/>
            <Label Text="{Res admin.dirset_profile_discovery_note}"
                   Overflow="Wrap"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="mt-2 [font-size:var(--kb-text-meta)]"/>
            <Label Text="{Res admin.dirset_personal_fields_note}"
                   Overflow="Wrap"
                   ForeColor="TextTertiary"
                   InheritFontSize="true"
                   Class="mt-2 [font-size:var(--kb-text-meta)]"/>
          </Panel>
        </Card>
        <Card Title="{Res admin.dirset_card_reach}" Subtitle="{Res admin.dirset_card_reach_desc}" IconSize="18" Icon="Building2">
          <!-- TODO(views-migrate): <AudienceRow> is no .kbview element (./AudienceRow#default) -->
          <ReactHost Component="{Binding AudienceRow}" Props="{Binding audience_row_props}"/>
        </Card>
      </Panel>
    </Panel>
    <!-- TODO(views-migrate): <InheritanceChainWindow> is no .kbview element (../../settings/InheritanceChainWindow#default) -->
    <ReactHost Component="{Binding InheritanceChainWindow}"
               Props="{Binding inheritance_chain_window_props}"
               Visible="{Binding show_chain_key}"/>
  </Panel>
</Panel>
