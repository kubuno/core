<!-- CategoryRow — converted from CategoryBreakdown.tsx by @kubuno/views-migrate (partial: see the TODO comments and the report). -->
<Panel x:Props="CategoryRowProps" HtmlTag="Li" Class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2">
  <!-- TODO(views-migrate): <span> with a computed style -->
  <ReactHost Component="{Binding Part1}" Props="{Binding part1_props}" Visible="{Binding props.showSwatch}"/>
  <Label HtmlTag="Span"
         Text="{Binding props.label}"
         ForeColor="TextPrimary"
         InheritFontSize="true"
         Class="min-w-0 flex-1 [font-size:var(--kb-text-body)]"/>
  <Badge Size="Sm" Variant="{Binding variant}" Text="{Binding badge_text}"/>
  <Label HtmlTag="Span"
         Text="{Res admin.sto_cat_objects, N={Binding sto_cat_objects_n}, Count={Binding props.row.object_count}}"
         Overflow="Wrap"
         ForeColor="TextTertiary"
         InheritFontSize="true"
         Visible="{Binding show_row_object_count}"
         Class="shrink-0 tabular-nums [font-size:var(--kb-text-meta)]"/>
  <Label HtmlTag="Span"
         Text="{Binding span_text}"
         Overflow="Wrap"
         ForeColor="TextPrimary"
         InheritFontSize="true"
         Class="shrink-0 tabular-nums [font-size:var(--kb-text-body)]"/>
</Panel>
