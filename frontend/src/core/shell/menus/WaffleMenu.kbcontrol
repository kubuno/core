<!--
  The app launcher (user control WaffleMenu, shared contract vskubuno docs/SHELL-CONTROLS.md §1): the favourites
  card, whose header band holds « Vos favoris » and its pencil — or, while editing, « Annuler », « OK » and the
  help line — over every other app (AppTileGrid), then « Plus de modules » for whoever may manage the marketplace,
  scrolling as one. 360 wide. The host (WaffleButton) gives it its chrome — a popover above the page — caps its
  height, and acts on its events.
-->
<UserControl x:Props="WaffleMenuProps" DesignWidth="360" DesignHeight="580" OnLoad="waffle_menu_load">
  <ScrollArea x:Name="body" Dock="Fill" ScrollbarGutter="StableBothEdges" Class="kb-inset-scroll">
    <Panel>
      <AppTileGrid x:Name="grid" Apps="{Binding apps}" Favorites="{Binding shown}" Editing="{Binding editing}"
                   DropHereText="{Res shell.drag_here}" AllFavoritesText="{Res shell.all_in_favorites}"
                   OnTileInvoked="grid_tile_invoked" OnFavoritesEdited="grid_favorites_edited">
        <AppTileGrid.Header>
          <Panel>
            <Stack Direction="LeftToRight" CrossAlign="Center" Justify="SpaceBetween" Gap="0" Padding="20, 16, 20, 4" Visible="{Binding viewing}">
              <Label Text="{Res shell.favorites}" Overflow="Wrap" ForeColor="TextPrimary" Class="text-base font-semibold"/>
              <IconButton x:Name="edit_button" Icon="Pencil" Diameter="40" Glyph="16" Filled="true" OnClick="edit_button_click"/>
            </Stack>
            <Panel Padding="16, 16, 16, 4" Visible="{Binding editing}">
              <Stack Direction="LeftToRight" CrossAlign="Center" Justify="SpaceBetween" Gap="0">
                <Button x:Name="cancel_button" Text="{Res common.cancel}" Variant="Ghost" Class="rounded-md px-5 bg-surface-2 hover:bg-surface-3" OnClick="cancel_button_click"/>
                <Button x:Name="ok_button" Text="{Res shell.ok}" Class="rounded-md px-6" OnClick="ok_button_click"/>
              </Stack>
              <Label Text="{Res shell.drag_apps}" ForeColor="TextSecondary" TextAlign="MiddleCenter" Overflow="Wrap" Margin="0, 12, 0, 0"/>
            </Panel>
          </Panel>
        </AppTileGrid.Header>
      </AppTileGrid>
      <MenuLink x:Name="marketplace" Text="{Res shell.more_modules}" Href="{Binding marketplaceHref}" Visible="{Binding showMarketplace}"
                Class="mt-3 mb-4 mx-[var(--kb-waffle-inset,26px)] flex items-center justify-center rounded-md border border-border px-4 py-2.5 text-center text-xs text-primary hover:bg-black/[0.04] transition-colors outline-none"
                OnClick="marketplace_click"/>
    </Panel>
  </ScrollArea>
</UserControl>
